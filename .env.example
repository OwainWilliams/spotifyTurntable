# Optional. Without it, the app asks for a Client ID on first run and keeps
# it in the browser. Client IDs are public (PKCE flow, no secret needed).
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
# Optional. Defaults to the app's own address (e.g. http://127.0.0.1:4545/).
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:4545/callback
