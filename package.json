{
  "name": "spotify-turntable",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4545 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4545 --strictPort",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/turntable.ps1 -Build",
    "app:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/startup.ps1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/monoton": "5.3.0",
    "react": "18.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "19.3.0",
    "@types/spotify-web-playback-sdk": "0.1.19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
